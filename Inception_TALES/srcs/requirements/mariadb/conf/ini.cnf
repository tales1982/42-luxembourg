# ########################################
# ##   OPCIONAL SE QUIZER CUSTMIZAR    ###
# ########################################

[mysqld]
user                    = mysql                      # Define o usuário do sistema para o processo mysqld
pid-file                = /run/mysqld/mysqld.pid     # Arquivo que armazena o PID do processo mysqld
socket                  = /run/mysqld/mysqld.sock    # Caminho do socket para conexões locais via Unix socket
port                    = 3306                       # Porta TCP na qual o servidor escuta por conexões
basedir                 = /usr                       # Diretório base onde estão os binários do MySQL/MariaDB
datadir                 = /var/lib/mysql             # Diretório onde os dados do banco são armazenados
tmpdir                  = /tmp                       # Diretório para arquivos temporários
lc-messages-dir         = /usr/share/mysql           # Diretório que contém os arquivos de mensagens do sistema (idiomas)
bind-address            = 0.0.0.0                    # Define que o servidor aceitará conexões de qualquer endereço IP
query_cache_size        = 16M                        # Tamanho do cache de queries, para otimização de desempenho
log_error               = /var/log/mysql/error.log   # Caminho do arquivo de log de erros do servidor
expire_logs_days        = 10                         # Dias após os quais os logs binários serão removidos automaticamente
character-set-server    = utf8mb4                    # Conjunto de caracteres padrão para o servidor (suporte completo a UTF-8)
collation-server        = utf8mb4_general_ci         # Collation padrão para o servidor (define a forma de ordenação e comparação de strings)
