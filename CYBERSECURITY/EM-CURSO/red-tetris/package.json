{
  "name": "red-tetris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Networked multiplayer Tetris - Full Stack JavaScript (42 project)",
  "scripts": {
    "dev": "concurrently -n server,client -c red,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
