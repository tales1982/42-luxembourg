# ============================================================
# Transcendence – Environment Variables
#
# O backend lê TODOS os segredos do Vault automaticamente.
# Apenas estas variáveis são necessárias aqui:
#   - BLOCKCHAIN_MINTER_KEY  → passada ao vault-init para ser
#     armazenada no Vault durante o docker compose up
#   - VAULT_TOKEN / VAULT_ADDR → convenência para uso do CLI
#     local do vault (vault kv get, etc.)
# ============================================================

# Chave privada da carteira com MINTER_ROLE (com prefixo 0x)
# Usada pelo vault-init para registrar no Vault na primeira subida.
BLOCKCHAIN_MINTER_KEY=0x6795d410bdf65504717814b42a4baef7497d6766d1d707065c00358e753dc839

# Acesso local ao Vault via CLI (opcional – só para desenvolvimento)
VAULT_TOKEN=transcendence-root-token
VAULT_ADDR=http://localhost:8200

# PgAdmin – interface web de administração do banco (dev only)
PGADMIN_EMAIL=admin@transcendence.com
PGADMIN_PASSWORD=admin123

# Etherscan – somente para verificação do contrato via forge verify-contract
ETHERSCAN_API_KEY=795d410bdf65504717814b42a4baef7497d6766d1d707065c00358e753dc839

#User One	user@email.com	Password123!
#User Two	user2@email.com	Password123!
